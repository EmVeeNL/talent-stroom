# Copy to .env (git-ignored) for local development. LOCAL DOCKER DATABASE ONLY:
# these are the public throwaway credentials from compose.yaml, never real secrets.

# Migrator connection (direct, never Hyperdrive). Locally the container superuser.
# For Neon: the ts_migrator login on the direct (non-pooled) endpoint, kept out of this file.
DATABASE_MIGRATION_URL=postgres://postgres:postgres_local_dev_only@127.0.0.1:5432/talentstroom

# Enables the integration tests in packages/database (they create and drop scratch databases).
DATABASE_TEST_URL=postgres://postgres:postgres_local_dev_only@127.0.0.1:5432/talentstroom
