{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "sortPackageJson": false,
  "astro": {},
  "associations": [
    {
      "files": ["*.astro"],
      "language": "astro"
    }
  ],
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "dist",
    ".turbo",
    ".wrangler",
    ".astro",
    "**/worker-configuration.d.ts",
    "docs/database",
    "docs/flows",
    "docs/images",
    "docs/logo",
    "docs/architecture",
    "docs/images/redesign"
  ]
}
