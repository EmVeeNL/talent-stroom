{
  "name": "talentstroom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:up": "docker compose up --detach --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes && docker compose up --detach --wait && node packages/database/src/cli.ts migrate --local && node packages/database/src/cli.ts dev-passwords --local",
    "db:migrate": "node --env-file-if-exists=.env packages/database/src/cli.ts migrate",
    "db:dev-passwords": "node --env-file-if-exists=.env packages/database/src/cli.ts dev-passwords",
    "visual": "pnpm --filter @talentstroom/web visual",
    "visual:install": "pnpm --filter @talentstroom/web visual:install"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
