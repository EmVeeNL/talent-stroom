flowchart TD
    A(["Authenticated read"])
    B["Compute cache key tenant/user/role/version"]
    C{"Sensitive or revoked content?"}
    D["Bypass shared cache; fetch private source"]
    E["Check bounded tenant-scoped cache"]
    F{"Hit?"}
    G["Read Neon and cache safe projection"]
    H(["Return result with proper Cache-Control"])
    A --> B
    B --> C
    C -->|Yes| D
    D --> H
    C -->|No| E
    E --> F
    F -->|Miss| G
    G --> H
    F -->|Hit| H
