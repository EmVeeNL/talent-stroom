flowchart TD
    A(["Scheduled backup or incident alert"])
    B["Verify Neon restore point and R2 object backups"]
    C{"Incident declared?"}
    D["Run periodic isolated restore drill"]
    E["Contain infrastructure and preserve evidence"]
    F["Restore to isolated branch and validate integrity"]
    G["Replay deletion tombstones / check KMS access"]
    H["Approve cutover with auditable change control"]
    I(["Verify RPO/RTO and publish postmortem"])
    A --> B
    B --> C
    C -->|No| D
    D --> I
    C -->|Yes| E
    E --> F
    F --> G
    G --> H
    H --> I
