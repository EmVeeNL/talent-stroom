flowchart TD
    A(["Authorized write or read request"])
    B{"Verify identity membership purpose and scope"}
    C["Deny and record security event"]
    D["Write: random DEK + AEAD nonce"]
    E["Encrypt record with bound AAD (tenant/id/version)"]
    F(["Wrap DEK via external KMS; store ciphertext"])
    G["Read: fetch ciphertext + wrapped DEK"]
    H["Unwrap using scoped KMS grant and decrypt"]
    I(["Check AEAD integrity and return minimum fields"])
    A --> B
    B -->|Denied| C
    B -->|Write| D
    D --> E
    E --> F
    B -->|Read| G
    G --> H
    H --> I
