flowchart TD
    A(["Portal request or recruiter revoke action"])
    B["Check token state against primary DB"]
    C{"Active and authorized?"}
    D(["Deny portal and document access"])
    E["Resolve scoped shortlist only"]
    F["Issue time-limited document access"]
    G(["Record access audit without raw token"])
    A --> B
    B --> C
    C -->|No| D
    C -->|Yes| E
    E --> F
    F --> G
    classDef start fill:#e4f3ff,stroke:#377ad6,color:#15243a
    classDef end fill:#dcfce8,stroke:#16a34a,color:#12331e
    classDef error fill:#fee2e2,stroke:#dc2626,color:#581b1b
    classDef decision fill:#fff1cc,stroke:#b7791f,color:#493010
    class A start
    class D,G end
    class C decision
