flowchart TD
    A(["Authenticated user opens security settings"])
    B{"Recent authentication required"}
    C["Reauthenticate"]
    D["Register WebAuthn passkey"]
    E{"Verify attestation / challenge / origin"}
    F["Discard credential and alert"]
    G["Store public key and credential metadata"]
    H["Offer TOTP + recovery codes"]
    I(["Log enrollment and notify user"])
    A --> B
    B -->|No| C
    C --> D
    B -->|Yes| D
    D --> E
    E -->|Fail| F
    E -->|Pass| G
    G --> H
    H --> I
