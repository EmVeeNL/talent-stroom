flowchart TD
    A(["Candidate enters interview stage"])
    B["Schedule and create follow-up task"]
    C{"Client decision or offer"}
    D(["Record rejection and outcome"])
    E["Confirm offer details and acceptance"]
    F{"Placement confirmed?"}
    G["Return to active pipeline"]
    H["Insert placement once, atomically"]
    I(["Record fee/currency and audit"])
    A --> B
    B --> C
    C -->|Rejected| D
    C -->|Offer| E
    E --> F
    F -->|No| G
    G -->|Retry| B
    F -->|Yes| H
    H --> I
    classDef start fill:#e4f3ff,stroke:#377ad6,color:#15243a
    classDef end fill:#dcfce8,stroke:#16a34a,color:#12331e
    classDef error fill:#fee2e2,stroke:#dc2626,color:#581b1b
    classDef decision fill:#fff1cc,stroke:#b7791f,color:#493010
    class A start
    class D,I end
    class C,F decision
