flowchart TD
    A(["User requests translation"])
    B["Choose source, target locale, content scope"]
    C{"Check rights and redact confidential fields"}
    D["Block or request restricted approval"]
    E["Queue translation with glossary and locale"]
    F["Review text and sensitive terminology"]
    G{"Human approves publication?"}
    H(["Keep draft only"])
    I(["Store locale variant and source revision"])
    A --> B
    B --> C
    C -->|Fail| D
    C -->|Pass| E
    E --> F
    F --> G
    G -->|No| H
    G -->|Yes| I
