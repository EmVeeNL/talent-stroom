{
  "name": "@talentstroom/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-env.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --env-file=/dev/null",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "openapi": "node scripts/openapi.ts && oxfmt openapi.json"
  },
  "dependencies": {
    "@better-auth/core": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "@talentstroom/contracts": "workspace:*",
    "@talentstroom/database": "workspace:*",
    "@talentstroom/i18n": "workspace:*",
    "better-auth": "catalog:",
    "hono": "catalog:",
    "kysely": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@talentstroom/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
