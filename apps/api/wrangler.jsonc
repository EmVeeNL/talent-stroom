{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "talentstroom-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  // No custom domain yet: deployed on *.workers.dev (docs/adr/0004-local-dev-and-hosting.md).
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  // Neon Postgres via Hyperdrive, caching disabled (docs/adr/0007-database-neon-hyperdrive.md).
  // Local dev: no localConnectionString here; set
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (see apps/api/.env.example).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ecb0b75f1af74a0eb91784d7bea6ec39",
    },
  ],
  // Workers Rate Limiting bindings (see "Rate limiting" in apps/api/README.md).
  // namespace_id must be a unique positive integer string per Cloudflare account; period is 10 or 60 only.
  // Counters are per Cloudflare location and approximate.
  "ratelimits": [
    { "name": "RATE_LIMIT_ANON", "namespace_id": "490001", "simple": { "limit": 120, "period": 60 } },
    { "name": "RATE_LIMIT_AUTH_ATTEMPT", "namespace_id": "490002", "simple": { "limit": 10, "period": 60 } },
  ],
  "vars": {
    "SERVICE_NAME": "api",
    "ENVIRONMENT": "development",
  },
}
