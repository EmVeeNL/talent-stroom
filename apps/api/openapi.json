{
  "components": {
    "parameters": {},
    "responses": {
      "InternalError": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        },
        "description": "Unexpected server error",
        "headers": {
          "X-Request-Id": {
            "description": "Request correlation ID",
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "MalformedJson": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        },
        "description": "Malformed JSON request body",
        "headers": {
          "X-Request-Id": {
            "description": "Request correlation ID",
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "NotFound": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        },
        "description": "Resource not found",
        "headers": {
          "X-Request-Id": {
            "description": "Request correlation ID",
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "PayloadTooLarge": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        },
        "description": "Request body exceeds 1 MiB",
        "headers": {
          "X-Request-Id": {
            "description": "Request correlation ID",
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "TooManyRequests": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        },
        "description": "Rate limit exceeded; see Retry-After",
        "headers": {
          "X-Request-Id": {
            "description": "Request correlation ID",
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "ValidationError": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationProblem"
            }
          }
        },
        "description": "Request validation failed",
        "headers": {
          "X-Request-Id": {
            "description": "Request correlation ID",
            "schema": {
              "type": "string"
            }
          }
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "properties": {
          "service": {
            "type": "string"
          },
          "status": {
            "enum": ["ok"],
            "type": "string"
          }
        },
        "required": ["status", "service"],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "requestId": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": ["type", "title", "status", "requestId"],
        "type": "object"
      },
      "ValidationProblem": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "properties": {
                "message": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": ["path", "message"],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "instance": {
            "type": "string"
          },
          "requestId": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [422],
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "enum": ["https://talentstroom.dev/problems/validation-error"],
            "type": "string"
          }
        },
        "required": ["type", "title", "status", "requestId", "errors"],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "TalentStroom API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "API health",
            "headers": {
              "X-Request-Id": {
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "webhooks": {}
}
