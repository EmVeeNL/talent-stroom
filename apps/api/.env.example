# Copy to apps/api/.env (git-ignored); `wrangler dev` reads it and refuses to start without
# a local Hyperdrive connection string. LOCAL DOCKER DATABASE ONLY (throwaway password set
# by `pnpm db:reset`).
# Hyperdrive local override for the HYPERDRIVE binding: wrangler dev connects straight to the
# compose.yaml Postgres as the runtime role ts_app (no pooling or caching locally, ADR 0007).
# `cf-typegen` passes --env-file=/dev/null so this file never leaks into the generated Env type.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://ts_app:ts_app_local_dev_only@127.0.0.1:5432/talentstroom
