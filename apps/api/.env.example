# Copy to apps/api/.env (git-ignored); `wrangler dev` reads it and refuses to start without
# the local Hyperdrive connection strings. LOCAL DOCKER DATABASE ONLY (throwaway passwords set
# by `pnpm db:reset`). Every value below is a public placeholder for local development.
# `cf-typegen` passes --env-file=/dev/null so this file never leaks into the generated Env type.

# Hyperdrive local overrides: wrangler dev connects straight to the compose.yaml Postgres
# (no pooling or caching locally, ADR 0007).
# HYPERDRIVE: tenant data as the runtime role ts_app.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://ts_app:ts_app_local_dev_only@127.0.0.1:5432/talentstroom
# HYPERDRIVE_AUTH: Better Auth and the session/membership check as ts_auth (ADR 0006, 0012).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_AUTH=postgres://ts_auth:ts_auth_local_dev_only@127.0.0.1:5432/talentstroom

# Better Auth. The secret signs session cookies and encrypts TOTP secrets: use any random
# local value (e.g. `openssl rand -base64 32`), never a value from a shared environment.
BETTER_AUTH_SECRET=replace-with-a-random-local-secret-of-at-least-32-characters
# Public origin the browser uses: the Vite dev server, which proxies /api/auth and /api/v1.
BETTER_AUTH_URL=http://localhost:5173

# Mail transport (ADR 0006 owner decision 7): "mailpit" sends to the local Mailpit HTTP API at
# http://127.0.0.1:8025 (inbox UI http://localhost:8025). wrangler.jsonc defaults to "none",
# which sends nothing and fails closed.
MAIL_TRANSPORT=mailpit

# Optional social sign-in; a provider is enabled only when both of its values are set.
# They must also be added to "secrets.required" in wrangler.jsonc, otherwise wrangler dev
# does not pass them to the Worker.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
