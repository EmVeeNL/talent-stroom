---
import "@talentstroom/ui/fonts.css";
import iconFont from "@talentstroom/ui/fonts/material-symbols/MaterialSymbolsRounded.woff2?url";
import "@talentstroom/ui/tokens.css";
import { t, type Locale } from "@talentstroom/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const lang = locale.slice(0, 2);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={iconFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <title>{t(locale, "app.name")} — {t(locale, "app.tagline")}</title>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#111827" />
    <link rel="alternate" hreflang="nl" href="/nl/" />
    <link rel="alternate" hreflang="en" href="/en/" />
  </head>
  <body>
    <slot />
  </body>
</html>
